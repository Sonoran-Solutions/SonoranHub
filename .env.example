# Root-level environment values are intentionally empty in the scaffold.
# Application-specific configuration belongs in the relevant app/package.

# OpenRouter capacity visibility. The management key is optional and enables
# account-level credit visibility through GET /api/v1/credits.
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=

# DeepSeek read-only capacity visibility.
DEEPSEEK_API_KEY=
