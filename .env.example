DATABASE_URL=postgresql://sonoran_hub:sonoran_hub@127.0.0.1:5432/sonoran_hub

# The API refreshes each provider independently every minute by default. This
# remains configurable for lower-volume accounts.
CAPACITY_REFRESH_INTERVAL_MS=60000

# OpenRouter capacity visibility. The management key is optional and enables
# account-level credit visibility through GET /api/v1/credits.
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=

# DeepSeek read-only capacity visibility.
DEEPSEEK_API_KEY=

# Optional server-side path override for the official local Codex CLI.
# The browser never receives this value. Default: codex
CODEX_BIN=codex

# Optional Vite-only URL for local development. This is not a secret.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Comma-separated browser origins allowed by the API. Defaults to both local Vite origins.
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
