{
  "name": "sonoran-hub",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @sonoran-hub/contracts build && pnpm --filter @sonoran-hub/config build && pnpm --filter @sonoran-hub/ai-capacity build",
    "dev:agent": "pnpm --filter @sonoran-hub/agent dev",
    "dev:api": "pnpm --filter @sonoran-hub/api dev",
    "dev:web": "pnpm --filter @sonoran-hub/web dev",
    "db:migrate": "node scripts/migrate-db.mjs",
    "smoke:deepseek": "pnpm build:packages && node scripts/smoke-deepseek.mjs",
    "smoke:openrouter": "pnpm build:packages && node scripts/smoke-openrouter.mjs",
    "smoke:codex": "pnpm build:packages && node scripts/smoke-codex.mjs",
    "smoke:gemini": "pnpm build:packages && node scripts/smoke-gemini.mjs",
    "smoke:agent-actions": "pnpm build:packages && node scripts/smoke-agent-actions.mjs",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,css,yml,yaml}\"",
    "lint": "eslint .",
    "test": "pnpm build:packages && vitest run",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
